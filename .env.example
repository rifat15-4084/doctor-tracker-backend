# ---------------------------------------------------------------------------
# Doctor Tracker - environment variables
# Copy this file to `.env` and fill in the real values.
#   Windows:  Copy-Item .env.example .env
#   macOS/Linux: cp .env.example .env
# Never commit the resulting `.env` file - it is git-ignored.
# ---------------------------------------------------------------------------

# [required] Runtime mode. Use "production" on Render.
# Controls cookie flags, error verbosity, log format and index creation.
NODE_ENV=development

# [required] Port the HTTP server listens on.
# Render injects its own PORT automatically - do not hard-code it there.
PORT=5000

# [required] MongoDB connection string. The server refuses to start without it.
# Local:  mongodb://127.0.0.1:27017/doctor-tracker
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/doctor-tracker?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/doctor-tracker

# [required in production] Secret used to sign JWTs. Minimum 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change_me_to_a_long_random_string_of_at_least_32_characters

# [optional] Token lifetime, in `ms` format: "7d", "12h", "30m". Default: 7d
JWT_EXPIRES_IN=7d

# [required in production] Allowed browser origin(s) for CORS.
# Comma separated; every entry must be an exact origin (scheme + host + port).
# Locally the defaults allow http://localhost:5173 (Vite) and
# http://localhost:3000 (Next.js dev server).
# Example: https://doctor-tracker.vercel.app,https://admin.example.com
CLIENT_URL=http://localhost:5173,http://localhost:3000

# [optional] morgan log format: dev | combined | common | short | tiny
# Defaults to "dev" locally and "combined" in production.
LOG_FORMAT=dev

# [optional] Master switch for the global API rate limiter ("true" / "false").
# Default: true. Login has its own stricter limiter (10 tries / 15 min).
RATE_LIMIT_ENABLED=true

# [optional] Name of the httpOnly session cookie. Default: dt_token
# COOKIE_NAME=dt_token

# [optional] Cookie domain. Leave empty for host-only cookies.
# Set to ".example.com" to share the cookie across subdomains.
# COOKIE_DOMAIN=
